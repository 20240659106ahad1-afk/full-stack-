PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_PASSWORD=change-this-admin-password
ADMIN_EMAIL=
NODE_ENV=development

# ---- Email (OTP codes, cancel and password notices) ----
# Leave all of these empty to print emails in the terminal while developing.

# Option A, on your own computer: Gmail with an App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Option B, for a live site (Render free plan blocks SMTP): Brevo API key. Needs MAIL_FROM too.
BREVO_API_KEY=

# The sender must be verified with your email provider. You may use an address
# alone, or a display name such as: Travel Bangladesh <sender@example.com>
MAIL_FROM=
